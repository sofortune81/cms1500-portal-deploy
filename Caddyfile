# Every site-specific value comes from portal.env. Do not edit this file.
{
    # Upstream errors (e.g. the portal restarting during an update) are logged through a
    # separate logger, http.log.error.<site logger name> — without this it would print the
    # full request URI, query string included, exactly what the filter below strips from the
    # access log. Keep this filter identical to the one in the site block.
    log portal_errors {
        include http.log.error.portal
        output stdout
        format filter {
            wrap json
            fields {
                request>uri regexp \?.* ""
                request>headers>Cookie delete
                request>headers>Authorization delete
            }
        }
    }
}

{$PORTAL_HOSTNAME} {
    import {$CADDY_TLS_DIR:/etc/caddy}/tls-{$PORTAL_TLS_MODE}.caddy
    encode gzip
    @blocked not remote_ip {$PORTAL_ALLOWED_RANGES}
    respond @blocked 403
    reverse_proxy {$PORTAL_UPSTREAM:portal:8000} {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    log portal {
        output stdout
        # The default json log records the full request URI, query string included:
        # /auth/callback?code=…, /api/claims?q=<patient name>, member-ID crop labels — values
        # review_portal/access_log.py strips from the portal's own log. Strip the query at
        # encode time; Cookie and Authorization are deleted outright (Caddy would otherwise
        # log them as REDACTED). Method, host, path, status and remote_ip are kept.
        format filter {
            wrap json
            fields {
                request>uri regexp \?.* ""
                request>headers>Cookie delete
                request>headers>Authorization delete
            }
        }
    }
}
