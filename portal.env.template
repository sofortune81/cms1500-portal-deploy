# Copy to portal.env beside docker-compose.yml. Never commit the copy.
PORTAL_IMAGE=ghcr.io/sofortune81/cms1500-portal
PORTAL_VERSION=1.0.0

# AWS account covered by your BAA. Textract and Bedrock bill here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Only needed to enter AWS keys on the Administration screen (AWS connection) instead of above:
# it encrypts the stored secret, and the screen refuses to save one while this is empty.
# Generate once with `openssl rand -base64 32` and never change it — a changed value makes the
# stored secret unreadable and it must be re-entered on the screen.
PORTAL_SECRET_KEY=

# local = password accounts managed on the Administration screen.
# entra = Microsoft sign-in; also set ENTRA_CLIENT_ID, ENTRA_TENANT_ID, ENTRA_REDIRECT_URI.
# ENTRA_TENANT_ID is a tenant GUID (that one organisation only), `organizations` (any work or
# school account) or `common` (those plus personal Microsoft accounts). With either of the last
# two, ENTRA_ALLOWED_TENANTS narrows it: comma-separated tenant GUIDs, and the portal refuses to
# start if it is set beside a GUID tenant or holds anything that is not a GUID. Leave it out and
# any organisation reaches the sign-in screen, where admin activation is the only gate.
AUTH_MODE=local
SESSION_COOKIE_SECURE=1
FORWARDED_ALLOW_IPS=127.0.0.1

# Daily licence check-in. Leave as issued; set empty only if your network policy blocks it.
LICENSE_SERVER_URL=https://license-server-staging-4ac0.up.railway.app

# Shared bearer token for the daily licence check-in, delivered with your licence. Leave
# unset only until your licence has been issued a token (the licence server accepts legacy
# tokenless check-ins until then).
# LICENSE_CHECKIN_TOKEN=

# TLS reverse proxy (Caddy), started only when COMPOSE_PROFILES=tls. The installer sets these.
# PORTAL_TLS_MODE: internal (Caddy's own CA), public (Let's Encrypt; needs public DNS and
# inbound 80/443) or files (certs/fullchain.pem + certs/privkey.pem beside this file).
# PORTAL_ALLOWED_RANGES: space-separated networks allowed to reach the portal.
# With the proxy on, FORWARDED_ALLOW_IPS above must equal PROXY_IP — the portal believes the
# client address only from that one peer. PROXY_IP is the top of PROXY_SUBNET: the portal
# starts first and receives the subnet's first dynamic address.
COMPOSE_PROFILES=
PROXY_IMAGE=ghcr.io/sofortune81/cms1500-proxy
PROXY_VERSION=2.10.2
PROXY_SUBNET=172.30.250.0/29
PROXY_IP=172.30.250.6
PORTAL_HOSTNAME=localhost
PORTAL_TLS_MODE=internal
PORTAL_ALLOWED_RANGES=0.0.0.0/0 ::/0
